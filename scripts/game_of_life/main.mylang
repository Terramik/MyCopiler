from ../defines.txt import all;
from std/mem import alloc, free;
from std/rand import seed, rand;
from std/io import stdout;
from std/time import sleep, NS;


alias bool_s2 (bool[,]);
alias uint8_s2 (uint8[,]);


def print_field(field_status bool_s2) {
    var y uint64; var x uint64;
    
    y = 0;
    while y < SIZE_Y {
        x = 0;
        while x < SIZE_X {
            if field_status[y][x] {
                stdout.putc(CELL_ALIVE);
            } else {
                stdout.putc(CELL_DEAD);
            }
            x = x + 1;
        }
        y = y + 1;
        stdout.putc('\n');
    }
}


